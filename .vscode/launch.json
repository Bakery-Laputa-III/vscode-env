{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Run (Release)",
            "program": "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-release-current",
            "console": "integratedTerminal",
            "env": {
                "PATH": "${env:PATH};C:/LLVM/bin"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug",
            "program": "${workspaceFolder}/bin/${fileBasenameNoExtension}.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build-debug-current",
            "console": "integratedTerminal",
            "sourceMap": {
                "/workspace": "${workspaceFolder}"
            },
            "env": {
                "PATH": "${env:PATH};C:/LLVM/bin"
            }
        }
    ]
}